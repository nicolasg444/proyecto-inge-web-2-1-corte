# .env.example - copia a .env (no se versiona). SOLO configuracion no
# secreta: los secretos viven en secrets/*.txt (scripts/generar-secretos.sh).

# --- Docker Compose ---
# Puerto del anfitrion para la web (cambialo si el 8080 esta ocupado).
WEB_PORT=8080
APP_VERSION=1.0
CACHE_TTL=30
FIREBASE_PROJECT_ID=wayture-37479
# false = modo local con el JSON de respaldo (sin Firestore).
USE_FIREBASE_REST=true
API_AUTH_ENABLED=true

# --- npm start (sin contenedores) ---
PORT=3000
JWT_SECRET_FILE=secrets/jwt_secret.txt
CSRF_SECRET_FILE=secrets/csrf_secret.txt
FIREBASE_API_KEY_FILE=secrets/firebase_api_key.txt
# Sin REDIS_HOST la cache queda desactivada.
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD_FILE=secrets/redis_password.txt
