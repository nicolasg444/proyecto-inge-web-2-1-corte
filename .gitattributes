# LF para todo lo que se ejecuta o se lee dentro de Linux (contenedores,
# WSL, kind). Con CRLF, bash falla con "$'\r': command not found".
*.sh            text eol=lf
*.mjs           text eol=lf
*.conf          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
Dockerfile*     text eol=lf
*.Dockerfile    text eol=lf
*.dockerignore  text eol=lf
